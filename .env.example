# =====================================================================
# 环境变量模板
# =====================================================================
# 用法：
#   1. 复制一份改名为 .env（.env 已在 .gitignore 里，不会被提交）
#   2. 填入真实值
#   3. 本地运行前加载它（见下方"本地加载方式"）
#
# ★ 这个 .env.example 文件只放占位符，可以放心提交。
# ★ 真实的 .env 永远不要提交、不要截图、不要贴到聊天里。
# =====================================================================


# ---------------------------------------------------------------------
# 行情数据源
# ---------------------------------------------------------------------

# Tushare Pro Token
# 获取：https://tushare.pro/user/token
# 说明：注册后在"个人主页 → 接口TOKEN"里，点"重置"可以作废旧 token
TUSHARE_TOKEN=

# 聚宽 JQData（可选，没用到可以留空）
# 获取：https://www.joinquant.com/default/index/sdk
JOINQUANT_PHONE=
JOINQUANT_PASSWORD=


# ---------------------------------------------------------------------
# LLM / NLP（策略发现、新闻情绪分析用）
# ---------------------------------------------------------------------

# HuggingFace Access Token
# 获取：https://huggingface.co/settings/tokens
# 建议：权限只勾 "Read"，不要用 Write token
HF_TOKEN=

# Groq API Key
# 获取：https://console.groq.com/keys
GROQ_API_KEY=

# 智谱 AI（可选）
ZHIPUAI_API_KEY=

# OpenAI 兼容接口（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=


# ---------------------------------------------------------------------
# 消息推送
# ---------------------------------------------------------------------

# 飞书自建应用
# 获取：https://open.feishu.cn/app → 你的应用 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 接收方 ID：群 chat_id 或用户 open_id
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=chat_id

# 钉钉机器人 Webhook（可选）
DD_WEBHOOK=

# Server 酱（微信推送，可选）
# 获取：https://sct.ftqq.com/
SCKEY=

# Telegram（可选）
TG_BOT_TOKEN=
TG_CHAT_ID=


# ---------------------------------------------------------------------
# 运行参数（非密钥，可以直接写死，也可以放 GitHub Variables）
# ---------------------------------------------------------------------
DATA_SOURCE=tushare
INTELLIGENCE_LEVEL=all


# =====================================================================
# 本地加载方式
# =====================================================================
#
# 【Windows PowerShell】—— 你的主力环境
#   在仓库根目录建一个 load_env.ps1（已在 .gitignore 里）：
#
#       Get-Content .env | ForEach-Object {
#           if ($_ -match '^\s*([A-Z_][A-Z0-9_]*)\s*=\s*(.*)$') {
#               [Environment]::SetEnvironmentVariable($Matches[1], $Matches[2], 'Process')
#           }
#       }
#
#   每次开新终端先跑：  . .\load_env.ps1
#   验证：              $env:TUSHARE_TOKEN
#
#
# 【Git Bash / WSL / Linux / macOS】
#       set -a && source .env && set +a
#   验证： echo $TUSHARE_TOKEN
#
#
# 【Python 里自动加载（推荐，最省事）】
#       pip install python-dotenv
#   然后在每个入口脚本最上面加两行：
#       from dotenv import load_dotenv
#       load_dotenv()
#   之后 os.environ.get('TUSHARE_TOKEN') 就能读到。
#
#
# 【永久写进 Windows 用户环境变量（不推荐，但最方便）】
#       [Environment]::SetEnvironmentVariable('TUSHARE_TOKEN','你的token','User')
#   缺点：所有程序都能读到，且不好按项目区分。
# =====================================================================
